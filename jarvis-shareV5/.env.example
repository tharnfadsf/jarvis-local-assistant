FISH_API_KEY=your_api_key_here
JARVIS_TTS_PROVIDER=fish
# Local Windows voice is used ONLY when explicitly chosen in the Voice panel.
# If the Fish Audio API fails, JARVIS reports the error instead of silently
# switching to the system voice.
JARVIS_TTS_FALLBACK=local
FISH_MODEL=s2.1-pro-free
# Your Fish Audio voice ID. Paste your own ID here; the shipped default is
# intentionally empty so a fresh install never speaks with someone else's voice.
# Set it in Voice Settings > Change Voice, or leave unset to use Local Windows voice.
FISH_REFERENCE_ID=
# Override the Fish Audio TTS endpoint ONLY for offline tests (FISH_TTS_URL).
# Leave unset in normal use; the real API https://api.fish.audio/v1/tts is the default.
# Default Google identity for Gmail/Drive browser actions (account chooser context).
# Set this to your own Google account so Gmail/Drive open in the right account.
# Leave blank to let Google show its account chooser instead of silently using
# whichever account happens to be first.
JARVIS_GOOGLE_ACCOUNT=your.name@example.com
# Browser tab control: auto (connect at startup + reconnect) or off.
JARVIS_TAB_CONTROL=auto
# Plain-Markdown memory vault (Obsidian-compatible). Leave unset to use the
# default %USERPROFILE%\Documents\JARVIS folder. Memory lives in Memory\*.md,
# conversation history in "Conversation Logs\YYYY-MM-DD.md" — separate from logs.
# Example: JARVIS_VAULT_PATH=%USERPROFILE%\Documents\JARVIS
JARVIS_VAULT_PATH=%USERPROFILE%\Documents\JARVIS
# Screen help (on-demand pointing): folder of the Clicky clone used for the
# blue pointer + locator. Leave unset for the default "..\clicky-windows"
# next to the jarvis folder. Optional budget/overlay timing overrides:
# JARVIS_SCREEN_HELP_BUDGET_MS=120000  JARVIS_SCREEN_HELP_SECONDS=12
# Windows UI Automation lane (exact named controls, no screenshot/model).
# Whole-desktop walks measured 0.4-2.0 s; raise only on very slow machines.
# JARVIS_SCREEN_HELP_UIA_MS=5000
JARVIS_CLICKY_DIR=..\clicky-windows
# ---- AI provider router (2026-10-19) ----
# Automatic failover across authorized providers plus a strict Local AI Only
# mode (ai-config.json chooses the mode; keys live ONLY in this .env file).
# OpenCode Zen: create a key at opencode.ai/console, paste it below.
OPENCODE_API_KEY=your_opencode_key_here
# Documented free models for the chat/completions endpoint include
# glm-5.3-flash-free and deepseek-v4.1-flash-free. JARVIS refuses paid
# models unless you explicitly set AI_ALLOW_PAID=1.
OPENCODE_MODEL=glm-5.3-flash-free
# OpenRouter (openrouter.ai/keys): documented OpenAI-compatible provider.
# Free models carry a ":free" suffix, e.g. nvidia/nemotron-3.5-super-vl:free.
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# AI_ALLOW_PAID=1
# AI_REMOTE_TIMEOUT_MS=45000
# Freebuff stays disabled until you configure an authorized, documented
# endpoint yourself (all three values). No proxy is installed automatically.
# AI_FREEBUFF_URL=
# AI_FREEBUFF_KEY=
# AI_FREEBUFF_MODEL=
